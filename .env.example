# Copy to .env ONLY for running on your own laptop. Never commit .env.
# On Maritime, set these in the agent's Environment settings instead.

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=any-long-random-string-you-make-up
PUBLIC_URL=

LLM_API_KEY=
# For a free Groq key (console.groq.com), uncomment these two lines:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

QUIZ_CRON=0 21 * * *
QUIZ_TIMEZONE=America/Los_Angeles
DATA_DIR=./data
